{
  "name": "nearby-teacher-backend",
  "version": "0.1.0",
  "description": "Backend API for the Nearby Teacher app",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "backfill:currency": "node scripts/backfill-currency.js",
    "backfill:currency:apply": "node scripts/backfill-currency.js --apply",
    "chat:start": "npm --prefix realtime start",
    "chat:test": "npm --prefix realtime test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
