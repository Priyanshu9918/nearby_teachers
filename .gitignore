# Dependencies (including the realtime service)
/vendor/
node_modules/

# Local environment configuration; keep example files versioned
.env
.env.*
!.env.example

# Laravel generated files
/bootstrap/cache/*.php
/storage/*.key
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/public/build/
/public/hot
/public/storage

# Test results and tool caches
/.phpunit.cache/
/.phpunit.result.cache
/.phpactor.json
/.phpunit-watcher.yml
/coverage/
/.nyc_output/

# Dependency manager logs and local credentials
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/auth.json

# Editor and operating system files
/.idea/
/.vscode/
/.fleet/
.DS_Store
Thumbs.db
*.swp
*.swo

# Firebase backend credentials
/storage/app/private/firebase/*
!/storage/app/private/firebase/.gitignore
/nearby_teacher.json
