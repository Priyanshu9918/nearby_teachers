        {
          "name": "GET /download?ref={{referralCode}} — Open referral link and award point",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "Mozilla/5.0"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/download?ref={{referralCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "download"
              ],
              "query": [
                {
                  "key": "ref",
                  "value": "{{referralCode}}"
                }
              ]
            },
            "description": "Public referral-link open. A valid code owner gets one point the first time this browser opens the link. The response sets a one-year cookie so repeat opens from that browser do not award another point. Postman must retain cookies between requests to verify deduplication."
          },
          "response": []
        },
