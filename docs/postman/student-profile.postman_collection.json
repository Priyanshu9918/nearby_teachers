{
  "info": {
    "_postman_id": "a409e1b3-533d-46aa-9d73-6d86d9745ce1",
    "name": "Nearby Teacher — Student Profile APIs",
    "description": "Student profile read/update, photo upload and teacher/institute public profile lookup. Set baseUrl, studentToken, teacherId and instituteId before using provider requests. Saved responses are fictional contract examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000", "type": "string"},
    {"key": "studentToken", "value": "", "type": "string"},
    {"key": "teacherId", "value": "", "type": "string", "description": "Target teacher user ID, not the teacher profile row ID."},
    {"key": "instituteId", "value": "", "type": "string", "description": "Target institute user ID, not the institute profile row ID."}
  ],
  "item": [
    {
      "name": "Student",
      "item": [
        {
          "name": "GET /student/profile — View my profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"]},
            "description": "Verified student bearer required. Returns the signed-in student's name, email, DOB, phone, phone_pin, profile image and completion state."
          },
          "response": [{
            "name": "Fictional example — 200 OK",
            "originalRequest": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"]}},
            "status": "OK", "code": 200, "_postman_previewlanguage": "json",
            "header": [{"key": "Content-Type", "value": "application/json"}], "cookie": [],
            "body": "{\n  \"profile\": {\n    \"userId\": \"10000000-0000-4000-8000-000000000001\",\n    \"name\": \"Asha Sharma\",\n    \"email\": \"asha@example.com\",\n    \"emailVerifiedAt\": \"2026-10-22T10:00:00.000000Z\",\n    \"dob\": \"2005-04-12\",\n    \"isMinor\": false,\n    \"phone\": \"+919876543210\",\n    \"phoneVerifiedAt\": \"2026-10-22T10:00:00.000000Z\",\n    \"phone_pin\": \"226010\",\n    \"profileImage\": \"https://example.test/storage/student-photos/asha.jpg\",\n    \"profileImageStatus\": \"approved\",\n    \"createdAt\": \"2026-10-22T10:00:00.000000Z\",\n    \"updatedAt\": \"2026-10-22T10:00:00.000000Z\"\n  },\n  \"profileComplete\": true\n}"
          }]
        },
        {
          "name": "PATCH /student/profile — Update profile fields",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Asha Sharma\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"+919876543211\",\n  \"phone_pin\": \"226010\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"]},
            "description": "Verified student bearer required. phone_pin is a regular profile field; no OTP is checked in this profile API. A changed phone is marked unverified. Email changes require email verification. Update DOB through POST /auth/date-of-birth."
          },
          "response": [{
            "name": "Fictional example — 200 Updated",
            "originalRequest": {"method": "PATCH", "header": [], "url": {"raw": "{{baseUrl}}/student/profile", "host": ["{{baseUrl}}"], "path": ["student", "profile"]}},
            "status": "OK", "code": 200, "_postman_previewlanguage": "json",
            "header": [{"key": "Content-Type", "value": "application/json"}], "cookie": [],
            "body": "{\n  \"profile\": {\n    \"userId\": \"10000000-0000-4000-8000-000000000001\",\n    \"name\": \"Asha Sharma\",\n    \"email\": \"asha@example.com\",\n    \"emailVerifiedAt\": \"2026-10-22T10:00:00.000000Z\",\n    \"dob\": \"2005-04-12\",\n    \"isMinor\": false,\n    \"phone\": \"+919876543211\",\n    \"phoneVerifiedAt\": null,\n    \"phone_pin\": \"226010\",\n    \"profileImage\": \"https://example.test/storage/student-photos/asha.jpg\",\n    \"profileImageStatus\": \"approved\",\n    \"createdAt\": \"2026-10-22T10:00:00.000000Z\",\n    \"updatedAt\": \"2026-10-28T10:00:00.000000Z\"\n  },\n  \"profileComplete\": true\n}"
          }]
        },
        {
          "name": "POST /student/profile/photo — Upload profile image",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {"mode": "formdata", "formdata": [{"key": "profile_image", "type": "file", "src": ""}]},
            "url": {"raw": "{{baseUrl}}/student/profile/photo", "host": ["{{baseUrl}}"], "path": ["student", "profile", "photo"]},
            "description": "Verified student bearer required. Multipart image or profile_image field, JPEG/PNG/WebP, maximum 5 MB. The saved photo enters moderation."
          },
          "response": [{
            "name": "Fictional example — 201 Uploaded",
            "originalRequest": {"method": "POST", "header": [], "url": {"raw": "{{baseUrl}}/student/profile/photo", "host": ["{{baseUrl}}"], "path": ["student", "profile", "photo"]}},
            "status": "Created", "code": 201, "_postman_previewlanguage": "json",
            "header": [{"key": "Content-Type", "value": "application/json"}], "cookie": [],
            "body": "{\n  \"profileImage\": \"https://example.test/storage/student-photos/asha.jpg\",\n  \"profileImageStatus\": \"pending\",\n  \"message\": \"Photo uploaded; it will appear on your profile after review.\"\n}"
          }]
        }
      ]
    },
    {
      "name": "Teacher and Institute Profiles",
      "item": [
        {
          "name": "GET /profiles/teacher/{{teacherId}} — View teacher profile",
          "request": {
            "method": "GET",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{studentToken}}", "type": "string"}]},
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/profiles/teacher/{{teacherId}}", "host": ["{{baseUrl}}"], "path": ["profiles", "teacher", "{{teacherId}}"]},
            "description": "Set teacherId to the teacher's user ID. Returns public profile and subjects, not complete private account data. Learners can access this API. With a valid phone-verified studentToken, profile.phone is returned while the daily phone-reveal quota permits it (five distinct providers per day). Check phoneLimitReached and phoneRevealsRemainingToday. Select No Auth for public access without phone."
          },
          "response": []
        },
        {
          "name": "GET /profiles/institute/{{instituteId}} — View institute profile",
          "request": {
            "method": "GET",
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{studentToken}}", "type": "string"}]},
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/profiles/institute/{{instituteId}}", "host": ["{{baseUrl}}"], "path": ["profiles", "institute", "{{instituteId}}"]},
            "description": "Set instituteId to the institute's user ID. Returns public profile and subjects, not complete private account data. Learners can access this API. With a valid phone-verified studentToken, profile.phone is returned while the daily phone-reveal quota permits it (five distinct providers per day, shared with teacher lookups). Check phoneLimitReached and phoneRevealsRemainingToday. Select No Auth for public access without phone."
          },
          "response": []
        }
      ]
    }
  ]
}
