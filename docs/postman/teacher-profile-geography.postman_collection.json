                  "cookie": [],
                  "body": "{\n  \"user\": {\n    \"id\": \"10000000-0000-4000-8000-000000000001\",\n    \"full_name\": \"Ravi Kumar\",\n    \"email\": \"ravi@example.com\",\n    \"phone\": \"+919876543210\",\n    \"avatar_url\": \"https://example.test/storage/teacher-photos/ravi.jpg\",\n    \"avatar_status\": \"approved\",\n    \"phone_verified_at\": \"2026-10-22 10:00:00\",\n    \"profile_completed_at\": \"2026-10-22 10:00:00\"\n  },\n  \"profile\": {\n    \"id\": \"20000000-0000-4000-8000-000000000001\",\n    \"user_id\": \"10000000-0000-4000-8000-000000000001\",\n    \"primary_subject_id\": 1,\n    \"listing_name\": \"Ravi Kumar\",\n    \"is_profile_complete\": true,\n    \"bio\": \"Ravi Kumar is an experienced mathematics teacher who helps learners understand concepts with clarity and confidence. His lessons combine careful explanations, guided practice, and real examples from everyday life. He adapts each class to a student's current level, learning pace, and academic goals. Before introducing a new topic, he checks what the learner already knows and identifies ideas that need more support. Students receive clear feedback, useful practice questions, and a practical plan for continued improvement. Ravi teaches school mathematics, exam preparation, and foundational problem solving through home tuition and online classes. He encourages learners to ask questions, review mistakes without fear, and build consistent study habits. Parents receive regular updates about progress and next steps. His goal is to help every student become independent, motivated, and successful.\",\n    \"rate_per_hour\": \"500.00\",\n    \"currency\": \"INR\",\n    \"lesson_modes\": [\n      \"in_person\",\n      \"home_tuition\",\n      \"online\"\n    ],\n    \"latitude\": 25.3176,\n    \"longitude\": 82.9739,\n    \"address_text\": \"Sigra, Varanasi\",\n    \"city\": \"Varanasi\",\n    \"state\": \"Uttar Pradesh\",\n    \"country\": \"India\",\n    \"country_code\": \"IN\",\n    \"linkedin_url\": \"https://www.linkedin.com/in/example\",\n    \"slug\": \"ravi-kumar-varanasi\",\n    \"is_verified\": false,\n    \"verified_at\": null,\n    \"trial_days\": 3,\n    \"rating_avg\": \"4.80\",\n    \"rating_count\": 12,\n    \"district\": \"Varanasi\",\n    \"sub_district\": null,\n    \"locality\": \"Sigra\",\n    \"locality_type\": \"area\",\n    \"postal_code\": \"221010\",\n    \"location_details\": {\n      \"country\": \"India\",\n      \"state\": \"Uttar Pradesh\",\n      \"district\": \"Varanasi\",\n      \"city\": \"Varanasi\",\n      \"locality\": \"Sigra\"\n    },\n    \"public_page_slug\": \"ravi-kumar-varanasi\",\n    \"public_profile_slug\": \"ravi-kumar-varanasi\",\n    \"seo_slug\": \"ravi-kumar-varanasi\",\n    \"seo_country\": \"in\",\n    \"seo_city_slug\": \"varanasi\",\n    \"subjects\": [\n      {\n        \"id\": 1,\n        \"name\": \"Mathematics\"\n      }\n    ]\n  },\n  \"profileComplete\": true,\n  \"teacherSeoUrl\": \"https://teachers.example.test/teacher/ravi-kumar-varanasi\",\n  \"teacherProfileUrl\": \"https://teachers.example.test/teacher/ravi-kumar-varanasi\",\n  \"webPageUrl\": \"https://teachers.example.test/teacher/ravi-kumar-varanasi\",\n  \"subjects\": [\n    {\n      \"id\": 1,\n      \"name\": \"Mathematics\"\n    }\n  ]\n}"
