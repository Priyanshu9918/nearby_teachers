    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "subjectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "countryCode",
      "value": "IN",
      "type": "string"
    },
    {
      "key": "stateCode",
      "value": "UP",
      "type": "string"
    }
  ],
