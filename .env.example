APP_NAME="Nearby Teacher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=socketio

# Enable after provisioning shared Redis. Presence is separate from cache/queues.
PRESENCE_ENABLED=false
PRESENCE_REDIS_DB=2
# PRESENCE_REDIS_URL=redis://127.0.0.1:6379/2

# Socket.IO server and Laravel broadcast bridge. Shared secret stays server-side.
SOCKET_IO_INTERNAL_URL=http://127.0.0.1:6001
SOCKET_IO_LARAVEL_URL=http://127.0.0.1:8000
SOCKET_IO_SHARED_SECRET=
SOCKET_IO_HOST=127.0.0.1
SOCKET_IO_PORT=6001
SOCKET_IO_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SOCKET_IO_REDIS_URL=

# Developer portal login is independent from the browser admin account.
# Configure it with `php artisan developer:setup-login`.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD_HASH=

# Configure the browser admin account with `php artisan admin:setup-login`.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# App API integrations.
DATABASE_URL=
JWT_SECRET=
# Only effective in local/testing. Returns OTP in JSON without sending messages.
OTP_TEST_MODE=false
OTP_DELIVERY_CHANNELS=sms,whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=
# auto keeps India on MSG91 and other numbers on Twilio; select muzztech explicitly.
OTP_SMS_PROVIDER=auto
MUZZTECH_API_KEY=
MUZZTECH_SENDER_NAME=BSLONL
MUZZTECH_TEMPLATE_ID=
MUZZTECH_OTP_MESSAGE="Your Nearby Teacher verification code is {otp}. Valid for 10 minutes. Do not share this code with anyone."
# Confirm recipient format and success response against your provider account.
MUZZTECH_PHONE_FORMAT=digits
MUZZTECH_SUCCESS_FIELD=status
MUZZTECH_SUCCESS_VALUE=success
# Public project ID is sufficient for backend Firebase ID-token verification.
FIREBASE_PROJECT_ID=
# Optional private JSON file; relative to the project root or an absolute server path.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional legacy setting; not required for Google token verification.
FIREBASE_SERVICE_ACCOUNT_JSON=
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_ENCRYPTION=tls
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=20
MAIL_URL=
MAIL_EHLO_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Laravel mail sender identity.
MAIL_FROM_ADDRESS=no-reply@nearbyteacher.app
MAIL_FROM_NAME="Nearby Teacher"
# Legacy Express sender setting; Laravel uses MAIL_FROM_ADDRESS/MAIL_FROM_NAME.
EMAIL_FROM="Nearby Teacher <no-reply@nearbyteacher.app>"
SUPPORT_EMAIL=
IOS_APP_STORE_URL=https://apps.apple.com/in/app/bsl-british-school-of-language/id6751044599
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.britishschooloflanguage
APP_BASE_URL=https://bsl.international
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
POSTMARK_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Legacy Express runtime while routes are being ported.
PORT=4000
